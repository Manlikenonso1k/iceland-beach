APP_NAME=Iceland
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://icelandbeach.com


APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.icelandbeach.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
# Must be an email address — this previously held the mail password by mistake.
MAIL_FROM_ADDRESS="booking@icelandbeach.com"
MAIL_FROM_NAME="${APP_NAME}"


TGI_BASE_URL=https://integration-service.tgipay.com/integration/api/v1
TGI_PUBLIC_KEY=
TGI_PRIVATE_KEY=
TGIPAY_INTEGRATION_KEY=
# The tenants.slug row for the business that owns this website. EnsureResortTenant
# uses it to keep another Hospi Sales tenant out of this resort's booking ledger.
RESORT_TENANT_SLUG=iceland-beach
