# Docroot bridge: the deploy path is the web root, and Laravel's front
# controller lives one level down in public/. Everything is handed to it, and
# public/.htaccess (stock Laravel) takes it from there.
#
# This replaces the old site's 5 KB rule set, which served .php files from the
# docroot and routed Laravel through a laravel-app/ subdirectory. That layout is
# gone; those rules 404'd every Laravel URL through ErrorDocument /soon.php,
# which is why the site died whenever a deploy restored them.
RewriteEngine On
RewriteRule ^(.*)$ public/$1 [L]
